# DeepSeek — Lemon's model for initial Discord conversations
DEEPSEEK_API_KEY=your-deepseek-api-key

# Modal — supply these to the lab's Lemon sandbox, not the Hermes profile
# MODAL_TOKEN_ID=your-modal-token-id
# MODAL_TOKEN_SECRET=your-modal-token-secret

# Discord — Lemon's own bot token and the user IDs allowed to talk to him
DISCORD_BOT_TOKEN=your-lemon-discord-bot-token
DISCORD_ALLOWED_USERS=123456789012345678

# Telegram — Lemon's Telegram bot token and allowed user IDs
TELEGRAM_BOT_TOKEN=your-lemon-telegram-bot-token
TELEGRAM_ALLOWED_USERS=123456789012345678

# Voice — OpenAI key for Whisper STT and TTS (kept separate from the model key)
VOICE_TOOLS_OPENAI_KEY=your-openai-api-key

# Langfuse — Lemon's traces in the Hermes project, using an Ingestion key
HERMES_LANGFUSE_PUBLIC_KEY=pk-lf-your-lemon-project-key
HERMES_LANGFUSE_SECRET_KEY=sk-lf-your-lemon-project-key
HERMES_LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
