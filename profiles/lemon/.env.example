# DeepSeek — Lemon's model for initial Discord conversations
DEEPSEEK_API_KEY=your-deepseek-api-key

# Discord — Lemon's own bot token and the user IDs allowed to talk to him
DISCORD_BOT_TOKEN=your-lemon-discord-bot-token
DISCORD_ALLOWED_USERS=123456789012345678

# Roblox Assets MCP — Open Cloud key for Creator Store and Asset Delivery
ROBLOX_API_KEY=your-roblox-open-cloud-api-key

# Langfuse — Lemon's traces in the Hermes project, using an Ingestion key
HERMES_LANGFUSE_PUBLIC_KEY=pk-lf-your-lemon-project-key
HERMES_LANGFUSE_SECRET_KEY=sk-lf-your-lemon-project-key
HERMES_LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
