# OpenAI — Mint's model, transcription and speech (same key for both)
OPENAI_API_KEY=sk-proj-...
VOICE_TOOLS_OPENAI_KEY=sk-proj-...

# Telegram — Mint's bot token and allowed user IDs
TELEGRAM_BOT_TOKEN=123456789:your-mint-telegram-bot-token
TELEGRAM_ALLOWED_USERS=123456789

# Discord — Mint's bot token and allowed user IDs
DISCORD_BOT_TOKEN=your-mint-discord-bot-token
DISCORD_ALLOWED_USERS=123456789012345678

# Modal — Mint's own sandbox account
MODAL_TOKEN_ID=ak-...
MODAL_TOKEN_SECRET=as-...
