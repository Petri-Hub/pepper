# OpenAI — Mint's model, transcription and speech (same key for both)
OPENAI_API_KEY=sk-proj-...
VOICE_TOOLS_OPENAI_KEY=sk-proj-...

# API server — the endpoint Home Assistant's Hermes Voice integration calls
API_SERVER_ENABLED=true
API_SERVER_HOST=0.0.0.0
API_SERVER_PORT=8643
API_SERVER_KEY=your-mint-api-server-key

# Telegram — Mint's bot token and allowed user IDs
TELEGRAM_BOT_TOKEN=123456789:your-mint-telegram-bot-token
TELEGRAM_ALLOWED_USERS=123456789

# Discord — Mint's bot token and allowed user IDs
DISCORD_BOT_TOKEN=your-mint-discord-bot-token
DISCORD_ALLOWED_USERS=123456789012345678

# GitHub — Mint's App identity, the installation he acts through and his private key
GITHUB_APP_ID=5556825
GITHUB_APP_INSTALLATION_ID=177259464
GITHUB_APP_PRIVATE_KEY_PATH=/opt/data/profiles/mint/github-app.pem

# Home Assistant — Mint's own long-lived token and the lab's Home Assistant address
HASS_URL=http://homeassistant:8123
HASS_TOKEN=your-mint-home-assistant-long-lived-token

# Modal — Mint's own sandbox account
MODAL_TOKEN_ID=ak-...
MODAL_TOKEN_SECRET=as-...

# Langfuse — shared Hermes project, filtered to mint
HERMES_LANGFUSE_PUBLIC_KEY=pk-lf-...
HERMES_LANGFUSE_SECRET_KEY=sk-lf-...
HERMES_LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
HERMES_LANGFUSE_ENV=mint
