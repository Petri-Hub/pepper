# OpenAI — model, transcription and speech (same key for both)
OPENAI_API_KEY=sk-proj-...
VOICE_TOOLS_OPENAI_KEY=sk-proj-...

# Telegram — bot token from @BotFather, and who may talk to Pepper
TELEGRAM_BOT_TOKEN=123456789:your-telegram-bot-token
TELEGRAM_ALLOWED_USERS=123456789

# Discord — bot token, who may talk to Pepper, and any file type accepted
DISCORD_BOT_TOKEN=your-discord-bot-token
DISCORD_ALLOWED_USERS=123456789,987654321
DISCORD_ALLOW_ANY_ATTACHMENT=true

# GitHub App — "Pepper, Petri's Bot" on Petri-Hub; the .pem is mounted read-only by the lab
GITHUB_APP_ID=123456
GITHUB_APP_INSTALLATION_ID=12345678
GITHUB_APP_PRIVATE_KEY_PATH=/run/secrets/github-app.pem
